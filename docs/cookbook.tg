	// Try cache first
	cached := perform Cache("profile:" + userId).(string)
	if cached != "" {
		perform Metrics("cache_hit", 1)
		return cached
	}

	// Cache miss — hit DB
	perform Metrics("cache_miss", 1)
	profile := perform DB("SELECT * FROM profiles WHERE id = " + userId).(string)
	return profile
}

test "getProfile uses cache when available" {
	handle {
		result := getProfile("valid_token")
		assert result == "cached_profile"
	} with {
	case Auth(token string):
		resume("user_123")
