// ============================================================
// PATTERN 4: Pipeline data processing
// Clean left-to-right data transformation.
// ============================================================

/*
func double(x int) int    { return x * 2 }
func addTen(x int) int    { return x + 10 }
func clamp(x int, max int) int {
	if x > max { return max }
	return x
}

func process(input int) int {
	return input |> double |> addTen |> clamp(100)
}
// process(30) → clamp(addTen(double(30)), 100) → clamp(70, 100) → 70
// process(60) → clamp(addTen(double(60)), 100) → clamp(130, 100) → 100
*/

