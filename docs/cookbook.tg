// GoType Cookbook — real-world patterns for AI code generation.
// Each section is a self-contained, runnable .tg program.

// ============================================================
// PATTERN 1: Dependency injection via effects
// The function doesn't know WHERE data comes from. The handler decides.
// ============================================================

package main

import "fmt"

effect GetUser(id string) string
effect SaveUser(id string, name string)

func renameUser(id string, newName string) {
	oldName := perform GetUser(id).(string)
	fmt.Printf("Renaming %s to %s\n", oldName, newName)
	perform SaveUser(id, newName)
}

func main() {
	// In production: handler talks to a real database
	// In tests: handler returns mock data
	handle {
		renameUser("user_1", "New Name")
	} with {
	case GetUser(id string):
		resume("Old Name")
	case SaveUser(id string, name string):
		fmt.Printf("Saved: %s = %s\n", id, name)
		resume()
	}
}

// ============================================================
// PATTERN 2: Error handling without exceptions
// Use sum types for explicit, type-safe error handling.
// ============================================================

/*
type ApiResult = ApiOk{data string} | ApiErr{code int, msg string}

func callApi(url string) ApiResult {
	// In real code, this would perform an HTTP effect
	if url == "" {
		return ApiErr{code: 400, msg: "empty url"}
	}
	return ApiOk{data: "response from " + url}
}

func processResponse(r ApiResult) string {
	match r {
	case ApiOk{data}:
		return "Got: " + data
	case ApiErr{code, msg}:
		return fmt.Sprintf("Error %d: %s", code, msg)
	}
	return ""
}
*/

// ============================================================
// PATTERN 3: Testing with effects — zero mocking libraries
// The handler IS the mock, the stub, and the spy all in one.
// ============================================================

/*
effect DB(query string) string
effect Email(to string, body string)

func onboardUser(name string, email string) string {
	perform DB("INSERT INTO users (name) VALUES ('" + name + "')")
	perform Email(email, "Welcome, " + name + "!")
	return "onboarded: " + name
}

test "onboardUser sends welcome email" {
	var sentTo string
	handle {
		result := onboardUser("Alice", "alice@test.com")
		assert result == "onboarded: Alice"
		assert sentTo == "alice@test.com"
	} with {
	case DB(query string):
		resume("ok")
	case Email(to string, body string):
		sentTo = to
		resume()
	}
}

test "onboardUser inserts into database" {
	var queries []string
	handle {
		onboardUser("Bob", "bob@test.com")
		assert len(queries) == 1
	} with {
	case DB(query string):
		queries = append(queries, query)
		resume("ok")
	case Email(to string, body string):
		resume()
	}
}
