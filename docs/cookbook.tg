// ============================================================
// PATTERN 10: Composing effects — real-world service
// Multiple effects compose naturally. The handler wires everything.
// ============================================================

/*
effect Auth(token string) string
effect DB(query string) string
effect Cache(key string) string
effect Metrics(name string, value float64)

func getProfile(token string) string {
